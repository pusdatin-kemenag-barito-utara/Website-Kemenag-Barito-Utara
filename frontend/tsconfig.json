{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client", "node"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "skipLibCheck": true
  },
  "include": ["src/**/*", ".astro/types.d.ts", "astro.config.mjs", "sentry.*.ts"],
  "exclude": ["src/app/**", "src/db/**", "tests/**", "dist/**"]
}
