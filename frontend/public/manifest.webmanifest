      "description": "Lihat publikasi dan berita terbaru Kemenag Barito Utara.",
      "icons": [
        {
          "src": "/assets/icons/kemenag-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Layanan Digital PTSP",
      "short_name": "Layanan",
      "url": "/layanan?source=pwa_shortcut",
      "description": "Akses 43 layanan publik terpadu satu pintu.",
      "icons": [
        {
          "src": "/assets/icons/kemenag-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
