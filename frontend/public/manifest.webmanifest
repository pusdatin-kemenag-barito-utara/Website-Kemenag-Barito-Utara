{
  "name": "Kementerian Agama Kabupaten Barito Utara",
  "short_name": "Kemenag Barut",
  "description": "Portal resmi publikasi berita dan layanan digital Kementerian Agama Kabupaten Barito Utara, Kalimantan Tengah.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0f172a",
  "theme_color": "#059669",
  "orientation": "any",
  "lang": "id",
  "dir": "ltr",
  "categories": ["government", "news", "productivity"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/icons/kemenag-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/kemenag-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/kemenag-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/kemenag-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/branding/kemenag.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Berita Terkini",
      "short_name": "Berita",
