---
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { siteInfo } from "@/data/site";

import "@/styles/tailwind.css";
import "@/styles/globals.css";

interface Props {
  title?: string;
}

const { title = `Admin ${siteInfo.name}` } = Astro.props;

const __dirname = path.dirname(fileURLToPath(import.meta.url));
let criticalCss = "";
try {
  criticalCss = fs.readFileSync(
    path.join(__dirname, "../styles/critical.css"),
    "utf-8",
  );
} catch {
  criticalCss = "";
}
const pageTitle = title && typeof title === "string" && !title.includes(siteInfo.shortName)
  ? `${title} | ${siteInfo.shortName}`
  : title || `Admin ${siteInfo.name}`;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/assets/icons/kemenag-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/assets/branding/kemenag.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/kemenag-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
    <style is:inline>{criticalCss}</style>
  </head>
  <body class="font-sans antialiased">
    <slot />
    <script is:inline>
      (function () {
        try {
          var k = "admin-theme",
            t = document.documentElement,
            n = window.localStorage.getItem(k),
            r = n === "light" || n === "dark" ? n : "light";
          t.dataset.theme = r;
          r === "dark" ? t.classList.add("dark") : t.classList.remove("dark");
          t.style.colorScheme = r;
        } catch (e) {}
      })();
    </script>
  </body>
</html>
