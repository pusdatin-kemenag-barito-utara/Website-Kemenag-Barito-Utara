---
import criticalCss from "@/styles/critical.css?raw";
import { siteInfo } from "@/data/site";
import {
  organizationSchema,
  websiteSchema,
  navigationSchema,
} from "@/lib/structured-data";
import JsonLd from "@/components/features/seo/JsonLd";
import ChatWidget from "@/components/features/chat/ChatWidget.jsx";
import AccessibilityWidget from "@/components/features/accessibility/AccessibilityWidget.jsx";
import RealtimeSync from "@/components/common/RealtimeSync";
import PageViewTracker from "@/components/common/PageViewTracker";
import PwaRegister from "@/components/layout/PwaRegister";
import PushNotificationPrompt from "@/components/features/pwa/PushNotificationPrompt.jsx";
import AntiCopasGuard from "@/components/common/AntiCopasGuard.jsx";

import {
  getEnv,
  getSiteUrl,
  getGaId,
  getGtmId,
  getOneSignalAppId,
  getGoogleSiteVerification,
} from "@/lib/env";

import "@/styles/tailwind.css";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  author?: string;
  jsonLd?: unknown[];
}

const {
  title = siteInfo.shortName,
  description = siteInfo.description,
  canonical = "/",
  image = "/assets/icons/kemenag-512.png",
  type = "website",
  publishedTime,
  author,
  jsonLd = [],
} = Astro.props;

const BASE = getSiteUrl();
const oneSignalAppId = getOneSignalAppId();
const gaId = getGaId();
const gtmId = getGtmId();
const googleSiteVerification = getGoogleSiteVerification();

const publicEnv = {
  NEXT_PUBLIC_SITE_URL: getEnv("NEXT_PUBLIC_SITE_URL", BASE),
  NEXT_PUBLIC_SUPABASE_URL: getEnv("NEXT_PUBLIC_SUPABASE_URL"),
  NEXT_PUBLIC_SUPABASE_ANON_KEY: getEnv("NEXT_PUBLIC_SUPABASE_ANON_KEY"),
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: getEnv("NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"),
  NEXT_PUBLIC_TURNSTILE_SITE_KEY: getEnv("NEXT_PUBLIC_TURNSTILE_SITE_KEY"),
  NEXT_PUBLIC_GA_ID: gaId,
  NEXT_PUBLIC_GTM_ID: gtmId,
  NEXT_PUBLIC_ONESIGNAL_APP_ID: oneSignalAppId,
  NEXT_PUBLIC_PUSDATIN_URL: getEnv("NEXT_PUBLIC_PUSDATIN_URL"),
  NEXT_PUBLIC_SUPABASE_CMS_BUCKET: getEnv("NEXT_PUBLIC_SUPABASE_CMS_BUCKET", "cms-media"),
  PUBLIC_API_URL: getEnv("PUBLIC_API_URL"),
};

const pageTitle = title && typeof title === "string" && !title.includes(siteInfo.shortName)
  ? `${title} | ${siteInfo.shortName}`
  : title || siteInfo.shortName;
const isProd = import.meta.env.PROD || (BASE && !BASE.includes("localhost"));
const enableOneSignal = Boolean(oneSignalAppId && isProd);

const canonicalUrl = canonical.startsWith("http")
  ? canonical
  : `${BASE}${canonical.startsWith("/") ? canonical : "/" + canonical}`;
const imageUrl = image.startsWith("http")
  ? image
  : `${BASE}${image.startsWith("/") ? image : "/" + image}`;

const supabaseUrl = getEnv("NEXT_PUBLIC_SUPABASE_URL");
let supabaseOrigin = "";
try {
  if (supabaseUrl) {
    supabaseOrigin = new URL(supabaseUrl).origin;
  }
} catch {}

const siteDomain = new URL(BASE || "https://baritoutara.kemenag.go.id").hostname;
const imageMimeType = imageUrl.endsWith(".png")
  ? "image/png"
  : imageUrl.endsWith(".webp")
  ? "image/webp"
  : imageUrl.endsWith(".svg")
  ? "image/svg+xml"
  : "image/jpeg";
---

<html lang="id" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <!-- Dynamic Runtime SSR Public Environment Injection -->
    <script is:inline define:vars={{ publicEnv }}>
      window.__PUBLIC_ENV__ = Object.assign({}, window.__PUBLIC_ENV__ || {}, publicEnv);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#059669" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={author || siteInfo.name} />

    <!-- Open Graph / Facebook / WhatsApp / Telegram / LinkedIn — Enterprise Grade -->
    <meta property="og:site_name" content={siteInfo.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={imageMimeType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:modified_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}
    {type === "article" && <meta property="article:section" content="Berita & Informasi Publik" />}
    {type === "article" && <meta property="article:publisher" content={BASE} />}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={siteDomain} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <meta name="twitter:site" content="@kemenag_ri" />
    <meta name="twitter:creator" content="@kemenag_ri" />

    <!-- PWA & Mobile Web App Standalone Capabilities -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Kemenag Barut" />
    <meta name="application-name" content="Kemenag Barut" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#059669" />
    <meta name="msapplication-tap-highlight" content="no" />

    <!-- App Icons -->
    <link rel="icon" href="/assets/icons/kemenag-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/assets/branding/kemenag.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/kemenag-192.png" />

    <!-- Verification & Bot Directives -->
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Resource Hints & Priority Preconnects -->
    <link rel="preconnect" href={BASE} />
    {supabaseOrigin && (
      <>
        <link rel="preconnect" href={supabaseOrigin} crossorigin />
        <link rel="dns-prefetch" href={supabaseOrigin} />
      </>
    )}
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Typography Priority Load -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:inline>{criticalCss}</style>

    <!-- Standalone PWA In-App Navigation Interceptor (iOS & Android) -->
    <script is:inline>
      (function () {
        var isStandalone =
          window.navigator.standalone === true ||
          window.matchMedia("(display-mode: standalone)").matches ||
          window.matchMedia("(display-mode: fullscreen)").matches;

        if (isStandalone) {
          document.documentElement.classList.add("pwa-standalone");

          // Menjaga navigasi internal tetap di dalam jendela aplikasi standalone tanpa membuka browser URL bar
          document.addEventListener(
            "click",
            function (e) {
              var a = e.target.closest("a");
              if (!a || !a.href) return;
              if (
                a.target === "_blank" ||
                a.hasAttribute("download") ||
                a.getAttribute("rel")?.includes("external") ||
                a.href.startsWith("mailto:") ||
                a.href.startsWith("tel:") ||
                a.href.startsWith("javascript:")
              ) {
                return;
              }
              // Navigasi internal domain sama
              if (a.origin === window.location.origin) {
                e.preventDefault();
                window.location.assign(a.href);
              }
            },
            false
          );
        }
      })();
    </script>

    <JsonLd data={[organizationSchema(), websiteSchema(), navigationSchema(), ...jsonLd]} />

    <!-- Google Tag Manager & Google Analytics (GA4) Enterprise Data Layer Initialization -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
    </script>

    {(gtmId || gaId) && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.google-analytics.com" />
      </>
    )}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", gtmId);
      </script>
    )}
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          gtag("js", new Date());
          gtag("config", gaId, {
            send_page_view: false,
            anonymize_ip: true,
            cookie_flags: "SameSite=None;Secure",
            allow_google_signals: true,
            allow_ad_personalization_signals: false,
          });
        </script>
      </>
    )}

    {enableOneSignal && (
      <>
        <link rel="preconnect" href="https://cdn.onesignal.com" />
        <link rel="preconnect" href="https://onesignal.com" />
        <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
        <script is:inline define:vars={{ oneSignalAppId }}>
          window.OneSignalDeferred = window.OneSignalDeferred || [];
          window.OneSignalDeferred.push(async function (OneSignal) {
            await OneSignal.init({
              appId: oneSignalAppId,
              notifyButton: { enable: false },
              allowLocalhostAsSecureOrigin: true,
            });
          });
        </script>
      </>
    )}
  </head>
  <body class="font-sans antialiased">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <slot />
    <script is:inline>
      (function () {
        try {
          var k = window.location.pathname.startsWith("/admin") ? "admin-theme" : "site-theme",
            t = document.documentElement,
            n = window.localStorage.getItem(k),
            r = n === "light" || n === "dark" ? n : "light";
          t.dataset.theme = r;
          r === "dark" ? t.classList.add("dark") : t.classList.remove("dark");
          t.style.colorScheme = r;
        } catch (e) {}
      })();
    </script>
    <RealtimeSync client:load />
    <PageViewTracker client:idle />
    <PwaRegister client:idle />
    <PushNotificationPrompt client:idle />
    <AntiCopasGuard client:load />
    <ChatWidget client:idle />
    <AccessibilityWidget client:idle />
  </body>
</html>