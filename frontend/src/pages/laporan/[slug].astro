---
import { getLaporanCategoryBySlug, getAllLaporanCategories } from "@/lib/pocketbase/db";
import { normalizeLaporanCategory } from "@/lib/laporan-normalize";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LaporanCategoryShell from "@/components/features/laporan/LaporanCategoryShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

const { slug } = Astro.params;

let category: any = null;
let documents: any[] = [];
let allCategories: any[] = [];

try {
  const [res, cats] = await Promise.all([
    getLaporanCategoryBySlug(slug),
    getAllLaporanCategories(),
  ]);

  allCategories = cats || [];

  if (res?.category) {
    category = normalizeLaporanCategory(res.category, res.documents || []);
    documents = category.documents || [];
  }
} catch (err) {
  console.error(`[Laporan] Error loading category ${slug}:`, err);
  category = null;
}

if (!category) {
  if (slug !== "sop") {
    return Astro.redirect("/laporan/sop", 302);
  }
  return Astro.redirect("/404", 404);
}
---

<BaseLayout
  title={`${category.title} | Laporan dan Akuntabilitas Kemenag Barito Utara`}
  description={
    category.description ||
    `Daftar dokumen ${category.title} resmi Kementerian Agama Kabupaten Barito Utara.`
  }
  canonical={`/laporan/${category.slug}`}
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Laporan", url: "/laporan" },
      { name: category.title, url: `/laporan/${category.slug}` },
    ]),
  ]}
>
  <LaporanCategoryShell
    client:load
    slug={category.slug}
    category={category}
    documents={documents}
    allCategories={allCategories}
  />
</BaseLayout>