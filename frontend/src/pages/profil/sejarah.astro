---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SejarahShell from "@/components/features/profil/SejarahShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;
---

<BaseLayout
  title="Sejarah Instansi | Kemenag Barito Utara"
  description="Jejak langkah dan sejarah pengabdian Kantor Kementerian Agama Kabupaten Barito Utara dalam membimbing kehidupan beragama, pendidikan keagamaan, dan pelayanan masyarakat."
  canonical="/profil/sejarah"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Profil", url: "/profil/sejarah" },
      { name: "Sejarah", url: "/profil/sejarah" },
    ]),
  ]}
>
  <SejarahShell client:load />
</BaseLayout>
