---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StandarPelayananShell from "@/components/features/profil/StandarPelayananShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;
---

<BaseLayout
  title="Standar Pelayanan | Kemenag Barito Utara"
  description="Acuan resmi tolok ukur pelayanan publik di lingkungan Kantor Kementerian Agama Kabupaten Barito Utara."
  canonical="/profil/standar-pelayanan"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Profil", url: "/profil/sejarah" },
      { name: "Standar Pelayanan", url: "/profil/standar-pelayanan" },
    ]),
  ]}
>
  <StandarPelayananShell client:load />
</BaseLayout>
