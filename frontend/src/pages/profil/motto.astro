---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MottoShell from "@/components/features/profil/MottoShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;
---

<BaseLayout
  title="Motto Layanan (HAPAKAT) | Kemenag Barito Utara"
  description="Motto pelayanan resmi Kantor Kementerian Agama Kabupaten Barito Utara yang berlandaskan semangat kebersamaan dan kualitas prima."
  canonical="/profil/motto"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Profil", url: "/profil/sejarah" },
      { name: "Motto Layanan (HAPAKAT)", url: "/profil/motto" },
    ]),
  ]}
>
  <MottoShell client:load />
</BaseLayout>
