---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TugasFungsiShell from "@/components/features/profil/TugasFungsiShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;
---

<BaseLayout
  title="Tugas dan Fungsi | Kemenag Barito Utara"
  description="Mandat resmi, tugas utama, serta fungsi kelembagaan Kantor Kementerian Agama Kabupaten Barito Utara dalam menyelenggarakan tata kelola keagamaan yang profesional."
  canonical="/profil/tugas-fungsi"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Profil", url: "/profil/sejarah" },
      { name: "Tugas dan Fungsi", url: "/profil/tugas-fungsi" },
    ]),
  ]}
>
  <TugasFungsiShell client:load />
</BaseLayout>
