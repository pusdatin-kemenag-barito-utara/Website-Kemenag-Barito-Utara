---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MaklumatPelayananShell from "@/components/features/profil/MaklumatPelayananShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;
---

<BaseLayout
  title="Maklumat Pelayanan | Kemenag Barito Utara"
  description="Komitmen resmi Kantor Kementerian Agama Kabupaten Barito Utara dalam memberikan pelayanan publik yang berkualitas, transparan, dan berintegritas."
  canonical="/profil/maklumat-pelayanan"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Profil", url: "/profil/sejarah" },
      { name: "Maklumat Pelayanan", url: "/profil/maklumat-pelayanan" },
    ]),
  ]}
>
  <MaklumatPelayananShell client:load />
</BaseLayout>
