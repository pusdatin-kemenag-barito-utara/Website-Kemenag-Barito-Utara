---
import { siteInfo } from "@/data/site";
import { apiGet } from "@/lib/api-client";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomePage from "@/components/features/home/HomePage";
import { breadcrumbSchema } from "@/lib/structured-data";

// SSR on-demand (data dinamis dari backend Golang)
export const prerender = false;

let homeData: any = {};
let youtubeVideos: any[] = [];
let initialSettings: any = null;
try {
  const [home, videos, settings] = await Promise.all([
    apiGet("/home"),
    apiGet("/youtube").catch(() => []),
    apiGet("/settings").catch(() => null),
  ]);
  homeData = home || {};
  youtubeVideos = Array.isArray(videos) ? videos : [];
  initialSettings = settings || null;
} catch (err) {
  homeData = {};
}

const title = "Beranda";
const canonical = "/beranda";
---

<BaseLayout
  title={title}
  description={siteInfo.description}
  canonical={canonical}
  jsonLd={[breadcrumbSchema([{ name: "Beranda", url: "/beranda" }])]}
>
  <HomePage
    client:load
    homeData={homeData}
    youtubeVideos={youtubeVideos}
    initialSettings={initialSettings}
  />
</BaseLayout>