---
import { getPublicGaleri } from "@/lib/pocketbase/db";
import { normalizeCoverImageUrl, toCoverPreviewUrl } from "@/lib/cover-image";
import BaseLayout from "@/layouts/BaseLayout.astro";
import GaleriPageShell from "@/components/features/galeri/GaleriPageShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

function mapGaleriItems(rows: any[] = []) {
  return rows
    .filter(Boolean)
    .map((item: any) => {
      const normalizedThumb = normalizeCoverImageUrl(item?.thumb_url || item?.image_url || "");
      const previewImage = toCoverPreviewUrl(normalizedThumb);
      const fullImage = normalizeCoverImageUrl(item?.image_url || "");
      return {
        id: item?.id ?? null,
        title: item?.title || "Dokumentasi kegiatan",
        imageUrl: previewImage || "/assets/branding/kemenag.svg",
        fullImageUrl: fullImage || previewImage || "/assets/branding/kemenag.svg",
        linkUrl: item?.link_url && item.link_url !== "#" ? item.link_url : "",
        publishedAt: item?.published_at || item?.created || null,
      };
    });
}

let items: any[] = [];
try {
  const res = await getPublicGaleri(1, 100);
  items = mapGaleriItems(res.items);
} catch (err) {
  items = [];
}
---

<BaseLayout
  title="Galeri"
  description="Galeri dokumentasi kegiatan dan publikasi Kementerian Agama Barito Utara."
  canonical="/galeri"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Galeri", url: "/galeri" },
    ]),
  ]}
>
  <GaleriPageShell client:load items={items} />
</BaseLayout>