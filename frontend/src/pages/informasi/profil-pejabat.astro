---
import { apiGet } from "@/lib/api-client";
import { getPublicSeksiList } from "@/lib/pocketbase/db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfilPejabatShell from "@/components/features/informasi/ProfilPejabatShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

const SLUG_ORDER = [
  "kepala-kantor",
  "sekjen",
  "seksi-pendidikan-madrasah",
  "seksi-pendidikan-agama-islam",
  "seksi-pendidikan-diniyah-dan-pondok-pesantren",
  "seksi-bimas-islam",
  "penyelenggara-zakat-wakaf",
  "penyelenggara-hindu",
  "kua-kantor-urusan-agama",
];

let rawSeksiList: any[] = [];
try {
  const res = await apiGet("/seksi");
  rawSeksiList = Array.isArray(res?.seksi) ? res.seksi : [];
} catch (_err) {
  rawSeksiList = [];
}

if (!rawSeksiList || rawSeksiList.length === 0) {
  try {
    rawSeksiList = await getPublicSeksiList();
  } catch (_e) {
    rawSeksiList = [];
  }
}

const seksiList = rawSeksiList
  .map((s: any) => {
    const fotoUrl = s.foto_kepala || (s.foto_kepala_file ? `https://dbb.kemenag-baritoutara.com/api/files/seksi/${s.id}/${s.foto_kepala_file}` : "");
    return {
      ...s,
      foto_kepala: fotoUrl,
      foto_kepala_y: typeof s.foto_kepala_y === "number" ? s.foto_kepala_y : 50,
      id: String(s.id ?? ""),
      _count: { pegawai_seksi: Number(s.pegawai_count ?? s._count?.pegawai_seksi ?? 0) },
    };
  })
  .sort((a: any, b: any) => {
    let indexA = SLUG_ORDER.indexOf(a.slug);
    let indexB = SLUG_ORDER.indexOf(b.slug);
    if (indexA === -1) indexA = 999;
    if (indexB === -1) indexB = 999;
    if (indexA !== indexB) return indexA - indexB;
    return (a.judul || "").localeCompare(b.judul || "");
  });

const kepalaKantor = seksiList.find((s: any) => s.slug === "kepala-kantor") || null;
const pejabatList = seksiList.filter(
  (s: any) => s.slug !== "kepala-kantor" && s.slug !== "kua-kantor-urusan-agama",
);

const breadcrumb = [
  { label: "Beranda", href: "/beranda" },
  { label: "Informasi Publik", href: "/informasi" },
  { label: "Profil Pejabat" },
];
---

<BaseLayout
  title="Profil Pejabat"
  description="Kenali para pemimpin dan pejabat struktural yang mengabdi di Kantor Kementerian Agama Kabupaten Barito Utara."
  canonical="/informasi/profil-pejabat"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Informasi Publik", url: "/informasi" },
      { name: "Profil Pejabat", url: "/informasi/profil-pejabat" },
    ]),
  ]}
>
  <ProfilPejabatShell
    client:load
    breadcrumb={breadcrumb}
    kepalaKantor={kepalaKantor}
    pejabatList={pejabatList}
  />
</BaseLayout>