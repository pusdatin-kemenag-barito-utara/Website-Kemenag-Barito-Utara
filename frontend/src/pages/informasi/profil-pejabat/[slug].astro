---
import { apiGet } from "@/lib/api-client";
import { getPublicSeksiBySlug } from "@/lib/pocketbase/db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfilPejabatSlugShell from "@/components/features/informasi/ProfilPejabatSlugShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

const { slug } = Astro.params;

let seksiData: any = null;
try {
  const res = await apiGet(`/seksi/${slug}`);
  if (res?.seksi) {
    seksiData = res.seksi;
  }
} catch (_err) {
  seksiData = null;
}

if (!seksiData || !seksiData.pegawai || seksiData.pegawai.length === 0) {
  try {
    const pbData = await getPublicSeksiBySlug(slug);
    if (pbData) {
      seksiData = {
        ...(seksiData || {}),
        ...pbData,
        pegawai: pbData.pegawai && pbData.pegawai.length > 0 ? pbData.pegawai : (seksiData?.pegawai || []),
      };
    }
  } catch (_e) {}
}

if (!seksiData) {
  try {
    const listRes = await apiGet("/seksi");
    const found = (listRes?.seksi || []).find((s: any) => s.slug === slug);
    if (found) {
      seksiData = { ...found, pegawai: [] };
    }
  } catch (_e) {}
}

if (!seksiData) {
  return Astro.redirect("/informasi", 404);
}

// Pastikan URL foto dan posisi vertikal wajah terisi utuh
const fotoKepalaUrl = seksiData.foto_kepala || (seksiData.foto_kepala_file ? `https://dbb.kemenag-baritoutara.com/api/files/seksi/${seksiData.id}/${seksiData.foto_kepala_file}` : "");
const pegawais = (seksiData.pegawai || []).map((p: any) => ({
  ...p,
  foto: p.foto || (p.foto_file ? `https://dbb.kemenag-baritoutara.com/api/files/pegawai_seksi/${p.id}/${p.foto_file}` : ""),
  foto_y: typeof p.foto_y === "number" ? p.foto_y : 50,
}));
seksiData = {
  ...seksiData,
  foto_kepala: fotoKepalaUrl,
  foto_kepala_y: typeof seksiData.foto_kepala_y === "number" ? seksiData.foto_kepala_y : 50,
  pegawai: pegawais,
};
---

<BaseLayout
  title={`${seksiData.judul} | Kemenag Barito Utara`}
  description={seksiData.deskripsi || `Profil pejabat ${seksiData.judul} Kantor Kementerian Agama Kabupaten Barito Utara.`}
  canonical={`/informasi/profil-pejabat/${slug}`}
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Informasi Publik", url: "/informasi" },
      { name: "Profil Pejabat", url: "/informasi/profil-pejabat" },
      { name: seksiData.judul, url: `/informasi/profil-pejabat/${slug}` },
    ]),
  ]}
>
  <ProfilPejabatSlugShell client:load slug={slug} initialData={seksiData} />
</BaseLayout>