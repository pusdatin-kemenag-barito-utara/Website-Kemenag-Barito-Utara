---
import { getPublicSeksiList } from "@/lib/pocketbase/db";
import { buildLeadershipData } from "@/lib/seksi-normalize";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StrukturOrganisasiShell from "@/components/features/informasi/StrukturOrganisasiShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

const breadcrumb: any[] = [
  { label: "Beranda", href: "/beranda" },
  { label: "Informasi Publik", href: "/informasi" },
  { label: "Struktur Organisasi" },
];

let leadershipData: any[] = [];
try {
  const seksi = await getPublicSeksiList();
  leadershipData = buildLeadershipData(seksi);
} catch (err) {
  leadershipData = [];
}
---

<BaseLayout
  title="Struktur Organisasi"
  description="Bagan struktur organisasi dan profil pimpinan Kantor Kementerian Agama Kabupaten Barito Utara."
  canonical="/informasi/struktur-organisasi"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Informasi Publik", url: "/informasi" },
      { name: "Struktur Organisasi", url: "/informasi/struktur-organisasi" },
    ]),
  ]}
>
  <StrukturOrganisasiShell client:load breadcrumb={breadcrumb} leadershipData={leadershipData} />
</BaseLayout>