---
import { getPublicYoutubeVideos } from "@/lib/pocketbase/db";
import BaseLayout from "@/layouts/BaseLayout.astro";
import VideoPageShell from "@/components/features/video/VideoPageShell";
import { breadcrumbSchema } from "@/lib/structured-data";

export const prerender = false;

let videos = [];
try {
  videos = await getPublicYoutubeVideos(50);
} catch (err) {
  console.error("[VideoPage] Error loading videos:", err);
  videos = [];
}
---

<BaseLayout
  title="Video YouTube - Kementerian Agama Kabupaten Barito Utara"
  description="Dokumentasi visual video kegiatan, inovasi, dan pelayanan dari kanal YouTube resmi Kementerian Agama Kabupaten Barito Utara."
  canonical="/video"
  jsonLd={[
    breadcrumbSchema([
      { name: "Beranda", url: "/beranda" },
      { name: "Video", url: "/video" },
    ]),
  ]}
>
  <VideoPageShell client:load videos={videos} />
</BaseLayout>