# App / Server
PORT=8080
NEXT_PUBLIC_SITE_URL=https://baritoutara.kemenag.go.id

# Database (PostgreSQL / Supabase Connection Pooler)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Redis Cache (Optional, fallback to high-speed in-memory store)
REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_CMS_BUCKET=cms-media

# AI Chatbot API Keys (Backend)
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Security & Cloudflare Turnstile
