# ================================================================
# KEMENAG BARITO UTARA — UNIFIED MONOREPO .GITIGNORE
# Mengakomodir Root, Frontend (Astro 7 + React 19), & Backend (Go Fiber 3)
# ================================================================

# ----------------------------------------------------------------
# 1. Environment Variables & Secrets (Dikelola Terpusat di Infisical)
# ----------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ----------------------------------------------------------------
# 2. Node.js & Dependencies (Root & Frontend)
# ----------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------------------------------------------------------
# 3. Frontend Build Outputs & Caches (Astro, Vite, Tailwind)
# ----------------------------------------------------------------
dist/
**/dist/
.astro/
**/.astro/
.vite/
**/.vite/
.cache/
**/.cache/
.turbo/
**/.turbo/

# Legacy Next.js Caches & Builds (Shims only, no build output)
.next/
**/.next/
out/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts
.vercel
.netlify

# ----------------------------------------------------------------
# 4. Backend (Go Fiber 3, Air Live Reload & Compilers)
# ----------------------------------------------------------------
# Go Binaries & Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
**/bin/

# Air Hot-Reload & Temporary Runtime Folders
tmp/
**/tmp/
.air/
backend/.air/

# Delve Debugger & Go Crash Dumps
__debug_bin*
core

# ----------------------------------------------------------------
# 5. Testing, Reports, & Coverage (Vitest, Playwright, Go Test)
# ----------------------------------------------------------------
coverage/
**/coverage/
*.lcov
*.out
c.out
coverage.txt
profile.out
*.test
test-results/
playwright-report/
blob-report/
.nyc_output/
lighthouse-report*

